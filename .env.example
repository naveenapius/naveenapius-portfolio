# Sanity — public read-only config (blog content).
# Copy to .env.local for local dev; set the same vars in the Netlify dashboard.
# The dataset is public, so no API token is required for reads.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Resume link. Swap this and rebuild when the resume changes (no code edit needed).
# Falls back to the hardcoded Drive URL in lib/contact.js if unset.
NEXT_PUBLIC_RESUME_URL=https://drive.google.com/drive/u/2/folders/1Aibnb7FHhKuy3FO9xgq0ToKzOJ-t1mUL
